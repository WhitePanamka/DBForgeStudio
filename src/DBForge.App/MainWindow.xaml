<Window x:Class="DBForge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DBForge Studio" Height="850" Width="1320" MinHeight="680" MinWidth="1000" WindowStartupLocation="CenterScreen" Background="#F3F6FA">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111827" Padding="22,16">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="DBForge Studio" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="Проектирование схем, генерация SQL и работа с MS SQL Server" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionBadge" Text="● Не подключено" Foreground="#FCA5A5" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Button Content="Новый проект" Click="NewProject_Click" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="Открыть" Click="OpenProject_Click" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="Сохранить" Click="SaveProject_Click" Padding="14,8"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово. Подключите SQL Server или создайте схему локально."/>
            </StatusBarItem>
        </StatusBar>
        <TabControl x:Name="MainTabs" Margin="18" Background="White">
            <TabItem Header="Главная">
                <ScrollViewer>
                    <StackPanel Margin="26" MaxWidth="950" HorizontalAlignment="Left">
                        <TextBlock Text="Рабочее пространство проекта" FontSize="27" FontWeight="SemiBold"/>
                        <TextBlock Text="Единый MVP: проект, подключение к MS SQL Server, конструктор схемы, SQL-генератор, просмотр данных и базовые правила проверки." TextWrapping="Wrap" Margin="0,10,0,22" FontSize="14" Foreground="#475569"/>
                        <UniformGrid Columns="3">
                            <Border Background="#EFF6FF" Padding="18" Margin="0,0,12,0" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="ПРОЕКТ" Foreground="#1D4ED8"/>
                                    <TextBlock x:Name="ProjectNameLabel" Text="Новый проект" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F0FDF4" Padding="18" Margin="0,0,12,0" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="СХЕМА" Foreground="#166534"/>
                                    <TextBlock x:Name="EntityCountLabel" Text="0 сущностей" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF7ED" Padding="18" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="СУБД" Foreground="#9A3412"/>
                                    <TextBlock x:Name="DatabaseLabel" Text="SQL Server / localhost" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="Порядок работы" FontSize="19" FontWeight="SemiBold" Margin="0,28,0,12"/>
                        <TextBlock Text="1. Настройте подключение к localhost:1433.  2. Создайте сущности и поля.  3. Проверьте модель.  4. Просмотрите и сохраните SQL.  5. Применяйте скрипт только к тестовой базе после проверки." TextWrapping="Wrap" FontSize="14" Foreground="#334155"/>
                        <TextBlock Text="Важно: первая версия не заменяет резервное копирование и ручную проверку миграций. Перед применением DDL убедитесь, что выбрана тестовая база." TextWrapping="Wrap" Margin="0,18,0,0" Foreground="#B45309"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Подключение к SQL Server">
                <ScrollViewer>
                    <StackPanel Margin="22" MaxWidth="950" HorizontalAlignment="Left">
                        <TextBlock Text="Параметры подключения" FontSize="22" FontWeight="SemiBold"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Сервер" VerticalAlignment="Center"/>
                            <TextBox x:Name="HostBox" Grid.Column="1" Text="localhost" Margin="0,4,18,8" Padding="8"/>
                            <TextBlock Text="Порт" Grid.Column="2" VerticalAlignment="Center"/>
                            <TextBox x:Name="PortBox" Grid.Column="3" Text="1433" Margin="0,4,0,8" Padding="8"/>
                            <TextBlock Text="Пользователь" Grid.Row="1" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserBox" Grid.Row="1" Grid.Column="1" Text="" Margin="0,4,18,8" Padding="8"/>
                            <TextBlock Text="Пароль" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="3" Margin="0,4,0,8" Padding="8"/>
                            <TextBlock Text="База (необязательно)" Grid.Row="2" VerticalAlignment="Center"/>
                            <ComboBox x:Name="DatabaseCombo" Grid.Row="2" Grid.Column="1" Margin="0,4,18,8" Padding="6" IsEditable="True"/>
                            <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <Button Content="Проверить и загрузить базы" Click="Connect_Click" Padding="12,8" Margin="0,4,8,8"/>
                                <Button Content="Сохранить параметры" Click="SaveConnection_Click" Padding="12,8" Margin="0,4,0,8"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ConnectionDetails" Text="Соединение ещё не проверялось." TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock Text="Доступные базы данных" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10"/>
                        <ListBox x:Name="DatabaseList" Height="170" SelectionChanged="DatabaseList_SelectionChanged"/>
                        <TextBlock Text="Таблицы выбранной базы" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,10"/>
                        <ListBox x:Name="TableList" Height="190" SelectionChanged="TableList_SelectionChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Конструктор схемы">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,18,0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Сущности" FontSize="21" FontWeight="SemiBold"/>
                            <TextBox x:Name="EntityNameBox" Margin="0,12,0,8" Padding="9" ToolTip="Имя таблицы латиницей, например products"/>
                            <Button Content="Добавить сущность" Click="AddEntity_Click" Padding="10"/>
                            <Button Content="Удалить сущность" Click="DeleteEntity_Click" Padding="10" Margin="0,7,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="EntityList" Margin="0,14,0,0" DisplayMemberPath="Name" SelectionChanged="EntityList_SelectionChanged"/>
                    </DockPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Поля выбранной сущности" FontSize="21" FontWeight="SemiBold"/>
                        <DataGrid x:Name="FieldsGrid" Grid.Row="1" Margin="0,14" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" IsReadOnly="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridComboBoxColumn Header="Тип SQL" SelectedItemBinding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" Width="160" x:Name="TypeColumn"/>
                                <DataGridCheckBoxColumn Header="NOT NULL" Binding="{Binding IsRequired, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                <DataGridCheckBoxColumn Header="PK" Binding="{Binding IsPrimaryKey, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                <DataGridCheckBoxColumn Header="IDENTITY" Binding="{Binding IsAutoIncrement, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                                <DataGridCheckBoxColumn Header="UNIQUE" Binding="{Binding IsUnique, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                <DataGridTextColumn Header="Ссылка на таблицу" Binding="{Binding ReferenceEntity, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                <DataGridTextColumn Header="Поле ссылки" Binding="{Binding ReferenceField, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="Добавить поле" Click="AddField_Click" Padding="12,8" Margin="0,0,8,0"/>
                            <Button Content="Проверить модель" Click="ValidateModel_Click" Padding="12,8"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="SQL и миграции">
                <DockPanel Margin="18">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Генерация SQL для MS SQL Server" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Скрипт создаёт таблицы, первичные ключи, уникальные ограничения и внешние ключи из модели." Margin="0,7,0,12" Foreground="#475569"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Сгенерировать SQL" Click="GenerateSql_Click" Padding="12,8" Margin="0,0,8,0"/>
                            <Button Content="Сохранить .sql" Click="ExportSql_Click" Padding="12,8" Margin="0,0,8,0"/>
                            <Button Content="Применить к выбранной базе…" Click="ApplySql_Click" Padding="12,8"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBox x:Name="SqlPreview" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13" Margin="0,16,0,0" Padding="12"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Данные таблиц">
                <DockPanel Margin="18">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Обзор и редактирование данных" FontSize="22" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                            <TextBlock Text="Таблица" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="DataTableCombo" Width="240" IsEditable="True" Margin="0,0,10,0"/>
                            <TextBox x:Name="SearchBox" Width="220" Padding="7" ToolTip="Текст поиска" Margin="0,0,8,0"/>
                            <Button Content="Загрузить / найти" Click="LoadData_Click" Padding="12,7" Margin="0,0,8,0"/>
                            <Button Content="Добавить запись" Click="InsertRow_Click" Padding="12,7"/>
                        </StackPanel>
                        <TextBlock Text="Для первой версии редактирование выполняется добавлением записи; изменение и удаление записей добавляются после проверки основной модели." Foreground="#64748B" Margin="0,0,0,8"/>
                    </StackPanel>
                    <DataGrid x:Name="DataGridView" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Margin="0,8,0,0"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Правила и проверка">
                <StackPanel Margin="22" MaxWidth="950" HorizontalAlignment="Left">
                    <TextBlock Text="Базовые бизнес-правила" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Проверка имени таблицы/поля, наличия полей, единственного первичного ключа для типовой сущности, IDENTITY только для числового поля, корректности ссылок и допустимых типов данных." TextWrapping="Wrap" Margin="0,12,0,18"/>
                    <Button Content="Проверить текущую модель" Click="ValidateModel_Click" HorizontalAlignment="Left" Padding="14,9"/>
                    <TextBox x:Name="ValidationOutput" Margin="0,16,0,0" Height="350" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="12"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>